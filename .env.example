APP_ENV=development

POSTGRES_DB=rai
POSTGRES_USER=rai
POSTGRES_PASSWORD=rai_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://rai:rai_dev_password@postgres:5432/rai

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Sprint 3 — R.AI recommendation layer. Default is safe mock mode (no external LLM).
AI_MODE=mock
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=20
AGENT_BATCH_MAX=25
